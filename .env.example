# Server configuration
PORT=5000
NODE_ENV=development

# SMTP Server Configuration
# Gmail example provided below. For other providers, see SETUP.md

# Gmail SMTP Settings (Recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your Email Credentials
# For Gmail: Use App Password (not your account password)
# Get it from: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Where contact form inquiries are sent
# This is the agency email that receives customer inquiries
AGENCY_NOTIFICATION_EMAIL=your-email@gmail.com

# Optional: Enable SMTP debug logging (shows detailed email logs)
SMTP_DEBUG=false

# ============================================
# ALTERNATIVE SMTP PROVIDERS (copy one below)
# ============================================

# SendGrid Example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-api-key-here

# Outlook/Office365 Example:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password

# Custom SMTP Server Example:
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=username
# SMTP_PASS=password
